CREATE TABLE IF NOT EXISTS ${ADDB_SCHEMA}.form (
    "uuid" uuid PRIMARY KEY NOT NULL DEFAULT uuid_generate_v4(),
    "owner_sub" VARCHAR(64) NOT NULL,
    "slug" text NOT NULL,
    "label" text NOT NULL,
    "description" text,
    "created_at" timestamptz NOT NULL DEFAULT now(),
    "updated_at" timestamptz NOT NULL DEFAULT now(),
    "object_type_uuid" uuid REFERENCES ${ADDB_SCHEMA}.object_type(uuid) ON DELETE CASCADE,
    "object_schema_version" int NOT NULL,
    "is_schema_and_version_default" boolean NOT NULL DEFAULT false,
    "schema_override_config" jsonb NOT NULL DEFAULT '{}'::jsonb,
    "form_config" jsonb NOT NULL DEFAULT '{}'::jsonb,
    "use_form_config" boolean NOT NULL DEFAULT false
);


DROP INDEX IF EXISTS ${ADDB_SCHEMA}_form_type_version_default_constraint;
CREATE UNIQUE INDEX ${ADDB_SCHEMA}_form_type_version_default_constraint
  ON ${ADDB_SCHEMA}.form(object_type_uuid, object_schema_version)
  WHERE is_schema_and_version_default;

DROP INDEX IF EXISTS ${ADDB_SCHEMA}_form_slug_constraint;
CREATE UNIQUE INDEX ${ADDB_SCHEMA}_form_slug_constraint
  ON ${ADDB_SCHEMA}.form(slug);

DROP POLICY IF EXISTS form_policy_select ON ${ADDB_SCHEMA}.form;
CREATE POLICY form_policy_select ON ${ADDB_SCHEMA}.form
FOR SELECT
--  All object schemas publicly SELECTable
USING ( true );

DROP POLICY IF EXISTS form_policy_insert ON ${ADDB_SCHEMA}.form;
CREATE POLICY form_policy_insert ON ${ADDB_SCHEMA}.form
FOR INSERT
--  forms INSERTable when user has claims and is superadmin
WITH CHECK (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
);

DROP POLICY IF EXISTS form_policy_update ON ${ADDB_SCHEMA}.form;
CREATE POLICY form_policy_update ON ${ADDB_SCHEMA}.form
FOR UPDATE
--  forms UPDATEable when user has claims and is superadmin
USING (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
)
-- update policy requires both USING *and* WITH_CHECK, as the USING
-- decides which rows are updateable in the first place, and the
-- WITH_CHECK determines if the new updates fit with the policy (after
-- being approved by the USING expression)
WITH CHECK (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
);

DROP POLICY IF EXISTS form_policy_delete ON ${ADDB_SCHEMA}.form;
CREATE POLICY form_policy_delete ON ${ADDB_SCHEMA}.form
FOR DELETE
--  forms DELETEable claim sub matches owner or superuser
USING (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        (
            owner_sub IS NOT NULL AND
            owner_sub = current_setting('request.jwt.claims', true)::json->>'sub'

        ) OR
        -- User is marked as superadmin
        (
            public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
        )
    )
);

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}_form_update_trigger() RETURNS TRIGGER AS $$
BEGIN
    -- Maintain updated_at/created_at
    NEW.updated_at = now();
    IF OLD.created_at IS NOT NULL THEN
      NEW.created_at = OLD.created_at;
    END IF;
        -- Set owner_sub to the current sub if not already set, but don't override if it was already set.
    IF current_setting('request.jwt.claims', true) IS NOT NULL THEN
        IF OLD.owner_sub IS NOT NULL THEN
            -- Don't update original if it was originally set.
            NEW.owner_sub = OLD.owner_sub;
        ELSE
            --Otherwise, owner will be the current sub
            NEW.owner_sub := current_setting('request.jwt.claims', true)::json->>'sub';
        END IF;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE TRIGGER trigger_${ADDB_SCHEMA}_form_update_trigger
BEFORE INSERT OR UPDATE ON ${ADDB_SCHEMA}.form
FOR EACH ROW
EXECUTE FUNCTION ${ADDB_SCHEMA}_form_update_trigger();