
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'object_category') THEN
        CREATE TYPE ${ADDB_SCHEMA}.object_category AS ENUM ('person', 'document', 'document_file');
    END IF;
END$$;

CREATE TABLE IF NOT EXISTS ${ADDB_SCHEMA}.object_type (
    "uuid" uuid PRIMARY KEY NOT NULL DEFAULT uuid_generate_v4(),
    "owner_sub" VARCHAR(64) NOT NULL,
    "label" text NOT NULL,
    "slug" text NOT NULL UNIQUE,
    "category" object_category DEFAULT 'document'::object_category,
    "description" text,
    "data" jsonb,
    "created_at" timestamptz NOT NULL DEFAULT now(),
    "updated_at" timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT object_type_slug_unique UNIQUE (slug)
);

CREATE OR REPLACE VIEW ${ADDB_SCHEMA}.enum_values AS
SELECT
    t.typname AS enum_name,
    e.enumlabel AS enum_value
FROM pg_type t
JOIN pg_enum e ON t.oid = e.enumtypid
JOIN pg_namespace n ON n.oid = t.typnamespace
WHERE n.nspname = '${ADDB_SCHEMA}';

ALTER TABLE ${ADDB_SCHEMA}.object_type ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS object_type_policy_select ON ${ADDB_SCHEMA}.object_type;
CREATE POLICY object_type_policy_select ON ${ADDB_SCHEMA}.object_type
FOR SELECT
--  All object types publicly SELECTable
USING ( true );

DROP POLICY IF EXISTS object_type_policy_insert ON ${ADDB_SCHEMA}.object_type;
CREATE POLICY object_type_policy_insert ON ${ADDB_SCHEMA}.object_type
FOR INSERT
--  object_types INSERTable when user has claims and is superadmin
WITH CHECK (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
);

DROP POLICY IF EXISTS object_type_policy_update ON ${ADDB_SCHEMA}.object_type;
CREATE POLICY object_type_policy_update ON ${ADDB_SCHEMA}.object_type
FOR UPDATE
--  object_types UPDATEable when user has claims and is superadmin
USING (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
)
-- update policy requires both USING *and* WITH_CHECK, as the USING
-- decides which rows are updateable in the first place, and the
-- WITH_CHECK determines if the new updates fit with the policy (after
-- being approved by the USING expression)
WITH CHECK (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
);

DROP POLICY IF EXISTS object_type_policy_delete ON ${ADDB_SCHEMA}.object_type;
CREATE POLICY object_type_policy_delete ON ${ADDB_SCHEMA}.object_type
FOR DELETE
--  object_types DELETEable claim sub matches owner or superuser
USING (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        (
            owner_sub IS NOT NULL AND
            owner_sub = current_setting('request.jwt.claims', true)::json->>'sub'

        ) OR
        -- User is marked as superadmin
        (
            public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
        )
    )
);

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}_validate_object_type_data(data json) RETURNS boolean AS $func$
BEGIN
    IF jsonb_matches_schema(
        (
            $json$
            {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                    "field_mappings": {
                        "type": "object",
                        "properties": {
                            "label": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "geometry": {
                                "type": "string"
                            },
                            "start_date": {
                                "type": "string"
                            },
                            "end_date": {
                                "type": "string"
                            }
                        }
                    },
                    "api_overrides": {
                        "type": "object",
                        "properties": {
                            "domain": {
                                "type": "string"
                            },
                            "get": {
                                "type": "object",
                                "properties": {
                                    "include_jwt": {
                                        "type": "boolean"
                                    },
                                    "single": {
                                        "type": "string"
                                    },
                                    "list": {
                                        "type": "string"
                                    }
                                }
                            },
                            "post" : {
                                "type": "string",
                                "mappings": {
                                    "type": "object",
                                    "additionalProperties": {
                                            "type": "string"
                                        }
                                }
                                                                    
                            }
                        }
                    }
                }
            }
            $json$
        )::json,
        (data)::jsonb
    ) THEN 
        RETURN TRUE;
    ELSE 
        RETURN FALSE;
    END IF;
END;
$func$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}_object_type_update_trigger() RETURNS TRIGGER AS $$
BEGIN
    -- Maintain updated_at/created_at
    NEW.updated_at = now();
    IF OLD.created_at IS NOT NULL THEN
        NEW.created_at = OLD.created_at;
    END IF;

    -- Set owner_sub to the current sub if not already set, but don't override if it was already set.
    IF current_setting('request.jwt.claims', true) IS NOT NULL THEN
        IF OLD.owner_sub IS NOT NULL THEN
            -- Don't update original if it was originally set.
            NEW.owner_sub = OLD.owner_sub;
        ELSE
            --Otherwise, owner will be the current sub
            NEW.owner_sub := current_setting('request.jwt.claims', true)::json->>'sub';
        END IF;
    END IF;


    IF NEW.data IS NOT NULL AND NOT ${ADDB_SCHEMA}_validate_object_type_data(NEW.data::json) THEN
        RAISE sqlstate 'PGRST' USING
            message = json_build_object(
                -- 'code' must be present, and also a string
                'code', 'PT400',
                'message', 'json_data_invalid',
                'details', 'JSON data is invalid according to the object type schema'
                )::text,
            detail = json_build_object(
                -- 'status' must be present, and a number
                'status', 400,
                -- 'header' must also be present, and an empty object
                'headers', '{}'::json
            );
    END IF;


    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE TRIGGER trigger_${ADDB_SCHEMA}_object_type_update_trigger
BEFORE INSERT OR UPDATE ON ${ADDB_SCHEMA}.object_type
FOR EACH ROW
EXECUTE FUNCTION ${ADDB_SCHEMA}_object_type_update_trigger();
