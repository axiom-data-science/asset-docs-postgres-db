CREATE TABLE IF NOT EXISTS ${ADDB_SCHEMA}.fields_override_config (
    "uuid" uuid PRIMARY KEY NOT NULL DEFAULT uuid_generate_v4(),
    "owner_sub" VARCHAR(64) NOT NULL,
    "label" text NOT NULL,
    "description" text,
    "object_schema_uuid" uuid REFERENCES ${ADDB_SCHEMA}.object_schema(uuid) ON DELETE CASCADE,
    "object_schema_version" int NOT NULL,
    "config" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "created_at" timestamptz NOT NULL DEFAULT now(),
    "updated_at" timestamptz NOT NULL DEFAULT now()
);


CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}_fields_override_config_update_trigger() RETURNS TRIGGER AS $$
BEGIN
    -- Maintain updated_at/created_at
    NEW.updated_at = now();
    IF OLD.created_at IS NOT NULL THEN
        NEW.created_at = OLD.created_at;
    END IF;
    -- Set owner_sub to the current sub if not already set, but don't override if it was already set.
    IF current_setting('request.jwt.claims', true) IS NOT NULL THEN
    IF OLD.owner_sub IS NOT NULL THEN
        -- Don't update original if it was originally set.
        NEW.owner_sub = OLD.owner_sub;
    ELSE
        --Otherwise, owner will be the current sub
        NEW.owner_sub := current_setting('request.jwt.claims', true)::json->>'sub';
    END IF;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE TRIGGER trigger_${ADDB_SCHEMA}_fields_override_config_update_trigger
BEFORE INSERT OR UPDATE ON ${ADDB_SCHEMA}.fields_override_config
FOR EACH ROW
EXECUTE FUNCTION ${ADDB_SCHEMA}_fields_override_config_update_trigger();