    'system',
    form.uuid,
    fields_override_config.uuid,
    0
FROM ${ADDB_SCHEMA}.form AS form
JOIN ${ADDB_SCHEMA}.fields_override_config AS fields_override_config
  ON fields_override_config.label = 'Water Level Form Fields'
JOIN ${ADDB_SCHEMA}.object_schema AS object_schema
  ON object_schema.uuid = fields_override_config.object_schema_uuid
WHERE form.slug = 'water_level'
  AND object_schema.slug = 'water_level'
  AND fields_override_config.object_schema_version = form.object_schema_version
  AND NOT EXISTS (
      SELECT 1
      FROM ${ADDB_SCHEMA}.fields_override_config_to_form AS existing
      WHERE existing.form_uuid = form.uuid
        AND existing.fields_override_config_uuid = fields_override_config.uuid
  );
