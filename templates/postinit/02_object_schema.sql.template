CREATE TABLE IF NOT EXISTS ${ADDB_SCHEMA}.object_schema (
    "uuid" uuid PRIMARY KEY NOT NULL DEFAULT uuid_generate_v4(),
    "owner_sub" VARCHAR(64) NOT NULL,
    "slug" text NOT NULL,
    "label" text NOT NULL,
    "description" text,
    "version" int NOT NULL DEFAULT 1,
    "is_type_default" boolean NOT NULL DEFAULT false,
    "created_at" timestamptz NOT NULL DEFAULT now(),
    "updated_at" timestamptz NOT NULL DEFAULT now(),
    "object_type_uuid" uuid NOT NULL REFERENCES ${ADDB_SCHEMA}.object_type(uuid) ON DELETE CASCADE,
    "json_schema" jsonb NOT NULL DEFAULT '{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"default_schema.json","title":"Default Schema","description":"Open ended default schema","type":"object"}'::jsonb
);


DROP INDEX IF EXISTS ${ADDB_SCHEMA}_object_schema_type_default_constraint;
CREATE UNIQUE INDEX ${ADDB_SCHEMA}_object_schema_type_default_constraint
  ON ${ADDB_SCHEMA}.object_schema(object_type_uuid, version)
  WHERE is_type_default;

DROP INDEX IF EXISTS ${ADDB_SCHEMA}_object_schema_slug_constraint;
CREATE UNIQUE INDEX ${ADDB_SCHEMA}_object_schema_slug_constraint
  ON ${ADDB_SCHEMA}.object_schema(slug);



ALTER TABLE ${ADDB_SCHEMA}.object_schema
DROP CONSTRAINT IF EXISTS asset_object_schema_check_schema;

ALTER TABLE ${ADDB_SCHEMA}.object_schema
ADD CONSTRAINT asset_object_schema_check_schema
CHECK (
  --Custom handling of JSON schema constraint, raising a check_violation error
  --if schema doesn't match (along with list of errors)
  jsonschema_is_valid((json_schema)::json)
);

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}_object_schema_update_trigger() RETURNS TRIGGER AS $$
BEGIN
    -- Maintain updated_at/created_at
    NEW.updated_at = now();
    IF OLD.created_at IS NOT NULL THEN
      NEW.created_at = OLD.created_at;
    END IF;

    -- Set owner_sub to the current sub if not already set, but don't override if it was already set.
    IF current_setting('request.jwt.claims', true) IS NOT NULL THEN
    IF OLD.owner_sub IS NOT NULL THEN
        -- Don't update original if it was originally set.
        NEW.owner_sub = OLD.owner_sub;
    ELSE
        --Otherwise, owner will be the current sub
        NEW.owner_sub := current_setting('request.jwt.claims', true)::json->>'sub';
    END IF;
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}_object_schema_version_trigger() RETURNS TRIGGER AS $$
BEGIN
    -- Increment version on insert based on max existing version for the object type
    IF (SELECT COUNT(*) FROM ${ADDB_SCHEMA}.object_schema WHERE object_type_uuid = NEW.object_type_uuid) = 0 THEN
        NEW.version = 1;
    ELSE
      NEW.version = (SELECT COALESCE(MAX(version), 0) + 1 FROM ${ADDB_SCHEMA}.object_schema WHERE object_type_uuid = NEW.object_type_uuid);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE TRIGGER trigger_${ADDB_SCHEMA}_object_schema_insert_update
BEFORE INSERT OR UPDATE ON ${ADDB_SCHEMA}.object_schema
FOR EACH ROW
EXECUTE FUNCTION ${ADDB_SCHEMA}_object_schema_update_trigger();


CREATE OR REPLACE TRIGGER trigger_${ADDB_SCHEMA}_object_schema_insert
BEFORE INSERT ON ${ADDB_SCHEMA}.object_schema
FOR EACH ROW
EXECUTE FUNCTION ${ADDB_SCHEMA}_object_schema_version_trigger();