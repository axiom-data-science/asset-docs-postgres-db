-- Get the default schema for the object type, then see if there is a form set as the default for that schema and version, and if not take the most recently create form for that version
CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}.get_default_form_at_object_type_uuid("object_type_uuid" uuid) RETURNS ${ADDB_SCHEMA}.form as
$$
DECLARE
    default_form ${ADDB_SCHEMA}.form;
  BEGIN
    SELECT f.*
    INTO default_form
    FROM
        ${ADDB_SCHEMA}.form f
    WHERE
        f.object_schema_version = (SELECT version FROM get_default_schema_at_object_type_uuid(f.object_type_uuid))
        AND f.is_schema_and_version_default = true;

    IF default_form IS NULL THEN
      SELECT f.*
      INTO default_form
      FROM
          ${ADDB_SCHEMA}.form f
      WHERE
          f.object_schema_version = (SELECT version FROM get_default_schema_at_object_type_uuid(f.object_type_uuid)) AND
          f.object_type_uuid = get_default_form_at_object_type_uuid.object_type_uuid
      ORDER BY f.created_at DESC
      LIMIT 1;

    END IF;
    RETURN default_form;
  end
$$ language plpgsql;
