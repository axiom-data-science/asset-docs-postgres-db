CREATE TABLE IF NOT EXISTS ${ADDB_SCHEMA}.predicate (
    "uuid" uuid PRIMARY KEY NOT NULL DEFAULT uuid_generate_v4(),
    "predicate" VARCHAR(200) NOT NULL UNIQUE,
    "label" VARCHAR(200) NOT NULL,
    "inverse_label" VARCHAR(200),
    "is_directional" BOOLEAN NOT NULL DEFAULT TRUE
);

ALTER TABLE ${ADDB_SCHEMA}.predicate ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS predicate_policy_select ON ${ADDB_SCHEMA}.predicate;
CREATE POLICY predicate_policy_select ON ${ADDB_SCHEMA}.predicate
FOR SELECT
--  All object types publicly SELECTable
USING ( true );

DROP POLICY IF EXISTS predicate_policy_insert ON ${ADDB_SCHEMA}.predicate;
CREATE POLICY predicate_policy_insert ON ${ADDB_SCHEMA}.predicate
FOR INSERT
--  predicates INSERTable when user has claims and is superadmin
WITH CHECK (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
);

DROP POLICY IF EXISTS predicate_policy_update ON ${ADDB_SCHEMA}.predicate;
CREATE POLICY predicate_policy_update ON ${ADDB_SCHEMA}.predicate
FOR UPDATE
--  predicates UPDATEable when user has claims and is superadmin
USING (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
)
-- update policy requires both USING *and* WITH_CHECK, as the USING
-- decides which rows are updateable in the first place, and the
-- WITH_CHECK determines if the new updates fit with the policy (after
-- being approved by the USING expression)
WITH CHECK (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        current_setting('request.jwt.claims', true)::json->>'sub' IS NOT NULL AND
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
    )
);

DROP POLICY IF EXISTS predicate_policy_delete ON ${ADDB_SCHEMA}.predicate;
CREATE POLICY predicate_policy_delete ON ${ADDB_SCHEMA}.predicate
FOR DELETE
--  predicates DELETEable only by superadmins
USING (
    (
        current_setting('request.jwt.claims', true) IS NOT NULL AND
        -- User is marked as superadmin
        (
            public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
        )
    )
);
