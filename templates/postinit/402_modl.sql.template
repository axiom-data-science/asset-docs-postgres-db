              {"prop": "platform_name"},
              {"prop": "project"}
            ]
          },
          {"prop": "summary", "type": "long_text"}
        ],
        "description": "Essential dataset identification"
      },
      {
        "id": "creator-page",
        "label": "Creator",
        "fields": [
          {
            "prop": "creator.name",
            "label": "Name"
          },
          {
            "id": "creator2",
            "type": "objectWrapper",
            "label": "",
            "fields": [
              {
                "prop": "creator.institution",
                "label": "Organization",
                "settings": {
                  "descriptionPresentation": "tooltip"
                }
              },
              {
                "prop": "creator.sector",
                "label": "Sector",
                "settings": {
                  "descriptionPresentation": "tooltip"
                }
              }
            ],
            "layout": "horizontal"
          },
          {
            "prop": "creator.address",
            "label": "Address",
            "settings": {
              "descriptionPresentation": "tooltip"
            }
          },
          {
            "id": "creator1",
            "type": "objectWrapper",
            "label": "",
            "fields": [
              {
                "prop": "creator.city",
                "label": "City",
                "settings": {
                  "descriptionPresentation": "tooltip"
                }
              },
              {
                "prop": "creator.postal_code",
                "label": "Postal Code",
                "settings": {
                  "descriptionPresentation": "tooltip"
                }
              },
              {
                "prop": "creator.country",
                "label": "Country",
                "settings": {
                  "descriptionPresentation": "tooltip"
                },
                "defaultValue": "United States"
              },
              {
                "prop": "creator.state",
                "type": "stateSelector",
                "label": "State",
                "settings": {
                  "descriptionPresentation": "tooltip"
                }
              },
              {
                "prop": "creator.email",
                "label": "Email",
                "settings": {
                  "descriptionPresentation": "tooltip"
                }
              },
              {
                "prop": "creator.phone",
                "label": "Phone",
                "settings": {
                  "descriptionPresentation": "tooltip"
                }
              },
              {
                "prop": "creator.url",
                "label": "URL",
                "settings": {
                  "descriptionPresentation": "tooltip"
                }
              }
            ],
            "layout": "grid2"
          }
        ],
        "settings": {
          "boldDescription": true
        },
        "description": "Party responsible for collecting the data and/or creating the resource"
      },
      {
        "id": "contributors-list",
        "label": "Contributors List",
        "fields": [
          {
            "prop": "contributor",
            "type": "object",
            "label": "",
            "fields": [
              {
                "prop": "role",
                "type": "select",
                "settings": {
                  "boldLabel": true,
                  "showDescriptionForSelected": true
                }
              },
              {
                "id": "contributor-fields",
                "type": "objectWrapper",
                "label": "",
                "fields": [
                  {
                    "prop": "name"
                  },
                  {
                    "prop": "phone"
                  },
                  {
                    "prop": "email"
                  },
                  {
                    "prop": "url"
                  },
                  {
                    "prop": "affiliation"
                  }
                ],
                "layout": "grid3",
                "settings": {
