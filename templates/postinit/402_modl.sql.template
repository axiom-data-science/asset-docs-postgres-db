INSERT INTO ${ADDB_SCHEMA}.object_schema (
    owner_sub,
    slug,
    label,
    description,
    is_type_default,
    object_type_uuid,
    json_schema
) VALUES (
    'brian@axiomalaska.com',
    'modl_collection_s3timeseries',
    'MODL S3 Timeseries',
    'Default schema for MODL S3 Timeseries collection',
    true,
    (
        SELECT uuid FROM ${ADDB_SCHEMA}.object_type
        WHERE slug = 'modl_collection_s3timeseries'
        LIMIT 1
    ),
    '{
            "type": "object",
            "$defs": {
                "VarMap": {
                    "type": "object",
                    "title": "VarMap",
                    "required": [
                        "source",
                        "output"
                    ],
                    "properties": {
                        "output": {
                            "type": "string",
                            "title": "Output",
                            "description": "The output variable name in the dataset"
                        },
                        "source": {
                            "type": "string",
                            "title": "Source",
                            "description": "The source variable name in the input data"
                        }
                    },
                    "description": "Configure a single variable mapping"
                },
                "DayGlob": {
                    "type": "object",
                    "title": "DayGlob",
                    "properties": {
                        "day_pattern": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "Day Pattern",
                            "default": null,
                            "examples": [
                                "EW01_ADCP_{partition_date:%Y%m%d}_*.txt",
                                "EW01_wave_ioos_{partition_date:%Y%m%d}_*.txt"
                            ],
                            "description": "\nGlob pattern for daily files.\nThe `partition_date` is available for formatting\n"
                        }
                    },
                    "description": "Configure glob patterns for daily files in S3."
                },
                "DropColumns": {
                    "type": "object",
                    "title": "DropColumns",
                    "required": [
                        "column_names"
                    ],
                    "properties": {
                        "column_names": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "title": "Column Names"
                        },
                        "converter_type": {
                            "type": "string",
                            "const": "drop",
                            "title": "Converter Type",
                            "default": "drop"
                        }
                    }
                },
                "NcAttributes": {
                    "type": "object",
                    "title": "NcAttributes",
                    "properties": {
                        "variables": {
                            "type": "object",
                            "title": "Variables",
                            "description": "Variable-specific attributes",
                            "additionalProperties": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        },
                        "global_attributes": {
                            "type": "object",
                            "title": "Global Attributes",
                            "description": "Global attributes to add to the NetCDF file",
                            "additionalProperties": true
                        },
                        "additional_attributes_file": {
                            "type": "string",
                            "title": "Additional Attributes File",
                            "default": null,
                            "description": "Path to the file that defines additional attributes for source"
                        }
                    },
                    "description": "Configure variable and global dataset attributes"
                },
                "SplitOperator": {
                    "type": "object",
                    "title": "SplitOperator",
                    "required": [
                        "sep",
                        "output_variables",
                        "source_variable"
                    ],
                    "properties": {
                        "sep": {
                            "type": "string",
                            "title": "Sep",
                            "description": "The separator"
                        },
                        "col_data_type": {
                            "type": "string",
                            "title": "Col Data Type",
                            "default": "float",
                            "description": "The data type of the new variables"
                        },
                        "converter_type": {
                            "type": "string",
                            "const": "split",
                            "title": "Converter Type",
                            "default": "split"
                        },
                        "source_variable": {
                            "type": "string",
                            "title": "Source Variable",
                            "description": "The source variable to split into multiple columns"
                        },
                        "output_variables": {
                            "type": "object",
                            "title": "Output Variables",
                            "description": "Mapping of index number to output variable.",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "description": "Takes the source variable, splits it on the separator and  maps the resulting array to new variables"
                },
                "S3SourceConfig": {
                    "type": "object",
                    "title": "S3SourceConfig",
                    "required": [
                        "bucket"
                    ],
                    "properties": {
                        "bucket": {
                            "type": "string",
                            "title": "Bucket",
                            "description": "The S3 bucket name"
                        },
                        "prefix": {
                            "type": "string",
                            "title": "Prefix",
                            "default": "/",
                            "description": "The S3 prefix/folder where files are located"
                        }
                    },
                    "description": "Configuration for data coming from an S3 Bucket"
                },
                "PandasCSVReader": {
                    "type": "object",
                    "title": "PandasCSVReader",
                    "properties": {
                        "sep": {
                            "anyOf": [
                                {
