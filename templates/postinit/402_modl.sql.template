-- Insert the default schema for MODL (skip if slug already exists)
INSERT INTO ${ADDB_SCHEMA}.object_schema (
    owner_sub,
    slug,
    label,
    description,
    is_type_default,
    object_type_uuid,
    json_schema
) VALUES (
    'brian@axiomalaska.com',
    'modl',
    'MODL',
    'Default schema for MODL object type',
    true,
    (
        SELECT uuid FROM ${ADDB_SCHEMA}.object_type
        WHERE slug = 'modl'
        LIMIT 1
    ),
    '{
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MODL Dataset Metadata Schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Unique dataset identifier in ERDDAP e.g., Dominion Wave Buoy, Timeseries Data",
          "examples": ["South Fork Wind SFW01, Timeseries Data"]
        },
        "acknowledgement": {
          "type": "string",
          "description": "Acknowlegment of financial supporting entities or award numbers",
          "examples": [
            "This dataset is part of a MetOcean Cyberinfrastructure supported by the Integrated Ocean Observing System (IOOS) to streamline integration of data from offshore operations."
          ]
        },
        "comment": {
          "type": "string",
          "description": "Used to describe the buoy/platform and contributor",
          "examples": ["South Fork Wind Lidar buoy developed and deployed by Woods Hole Group"]
        },
        "contributor_name": {
          "type": "string",
          "description": "Contributor refers to individuals or institutions that contributed to creation of the data. We use for platform deployment/data provider entity",
          "examples": ["Woods Hole Group"]
        },
        "contributor_address": {
          "type": "string",
          "description": "physical address or city/state/country",
          "examples": ["107 Waterhouse Rd, Bourne, MA 02532"]
        },
        "contributor_url": {
          "type": "string",
          "format": "uri",
          "description": "Contributor website",
          "examples": ["https://www.woodsholegroup.com/"]
        },
        "contributor_email": {
          "type": "string",
          "format": "email",
          "description": "Creator primary contact",
          "examples": ["dwalsh@woodsholegroup.com"]
        },
        "creator_country": {
          "type": "string",
          "description": "Creator refers to owner/operator of platform, used here for owner/operator of deployed platform",
          "examples": ["USA"]
        },
        "creator_name": {
          "type": "string",
          "description": "Name of creator entity e.g., Coastal Virginia Offshore Wind or Dominion Energy",
          "examples": ["South Fork Wind"]
        },
        "creator_address": {
          "type": "string",
          "description": "mailing address",
          "examples": ["524 Montauk Hwy, Amagansett, NY 11930"]
        },
        "creator_state": {
          "type": "string",
          "description": "state of operation",
          "examples": ["New York"]
        },
        "creator_URL": {
          "type": "string",
          "format": "uri",
          "description": "Creator website",
          "examples": ["https://southforkwind.com"]
        },
        "creator_email": {
          "type": "string",
          "format": "email",
          "description": "primary contact",
          "examples": ["info@southforkwind.com"]
        },
        "institution": {
          "type": "string",
          "description": "Institution name",
          "examples": [
            "South Fork Wind - a partnership between Ørsted and Global Infrastructure Partners"
          ]
        },
        "creator_sector": {
          "type": "string",
          "description": "IOOS classifier for sector",
          "enum": ["gov_state", "nonprofit", "industry", "academic", "gov_federal", "tribal"],
          "examples": ["industry"]
        },
        "geometry": {
          "type": "object"
        },
        "id": {
          "type": "string",
          "description": "Unique Platform/Station ID",
          "examples": ["SFW01"]
        },
        "infoURL": {
          "type": "string",
          "format": "uri",
          "description": "Best website for information about program",
          "examples": ["https://southforkwind.com"]
        },
        "license": {
          "type": "string",
          "description": "General license language for re-use/access of data in ERDDAP platform",
          "examples": [
            "The data may be used and redistributed for free but is not intended for legal use, since it may contain inaccuracies. Neither the data Contributor, Orsted, NOAA, nor the United States Government, nor any of their employees or contractors, makes any warranty, express or implied, including warranties of merchantability and fitness for a particular purpose, or assumes any legal liability for the accuracy, completeness, or usefulness, of this information."
          ]
        },
        "platform_name": {
          "type": "string",
          "description": "Project or individual platform",
          "examples": ["South Fork Wind"]
        },
        "processing_level": {
          "type": "string",
          "description": "Processing level of data (raw, qc, level 1, etc)",
          "examples": ["raw dataset, no qc provided"]
        },
        "project": {
          "type": "string",
          "description": "Name of wind project",
          "examples": ["South Fork Wind"]
        },
        "publisher_country": {
          "type": "string",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "examples": ["USA"]
        },
        "publisher_email": {
          "type": "string",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "examples": ["devops@rpsgroup.com, info@neracoos.org"]
        },
        "publisher_institution": {
          "type": "string",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "examples": ["MARACOOS, NERACOOS"]
        },
        "publisher_name": {
          "type": "string",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "examples": ["MARACOOS, NERACOOS"]
        },
        "publisher_phone": {
          "type": "string",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "examples": ["(401) 789-6224, (603) 319-1785"]
        },
        "publisher_type": {
          "type": "string",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "examples": ["institution"]
        },
        "publisher_url": {
          "type": "string",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "examples": ["https://www.maracoos.org, https://www.neracoos.org"]
        },
        "summary": {
          "type": "string",
          "description": "Basic summary of dataset - location, platform, variables collected",
          "examples": [
            "This dataset contains observations to support further understanding of metocean conditions off the coast of New York, Rhode Island and Southeastern Massachusetts. Data is collected from a floating lidar buoy and the dataset includes  measurements of sea temperature (surface and sea floor), current speed, current direction, wave height, wave direction, and wave period, air temperature, atmospheric pressure, relative humidity, visibility, surface wind speed,  surface wind direction, and surface wind gust."
          ]
        },
        "Instrument": {
          "type": "string",
          "description": "Instruments used, varies by variable-  see DP metadata - use at attribute level as component (with each variable) or global (separate by comma)",
          "examples": [
            "Campbell Scientific MetSENS 500, Campbell Scientific CS120 Visibility Sensor, Garmin GPS16X-HVS, Seaview SVS-603b, Nortek Aquadopp Profiler Z-Cell 600kHz"
          ]
        }
      },
      "required": ["title", "id"]
    }'::jsonb
)
ON CONFLICT (slug) DO NOTHING;

