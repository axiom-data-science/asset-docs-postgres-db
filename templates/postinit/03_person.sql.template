-- DROP TABLE IF EXISTS ${ADDB_SCHEMA}.person CASCADE;

CREATE TABLE IF NOT EXISTS ${ADDB_SCHEMA}.person (
    "uuid" uuid NOT NULL DEFAULT uuid_generate_v4(),
    "owner_sub" VARCHAR(64) NOT NULL,
    "lock_sub" VARCHAR(64) NULL,
    "locked_at" timestamptz NULL,
    "subs_for_select" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "roles_for_select" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "subs_for_update" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "roles_for_update" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "data" jsonb NOT NULL DEFAULT '{}'::jsonb,
    "attrs" jsonb NOT NULL DEFAULT '{}'::jsonb,
    "json_schema" jsonb NOT NULL DEFAULT '{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"person","title":"Person","type":"object"}'::jsonb,
    "created_at" timestamptz NOT NULL DEFAULT now(),
    "updated_at" timestamptz NOT NULL DEFAULT now(),
    "type" varchar(256) NOT NULL DEFAULT '',
    "label" varchar(256) NOT NULL DEFAULT '',
    "description" text NOT NULL DEFAULT '',
    "comments" text NOT NULL DEFAULT '',
    CONSTRAINT person_pkey PRIMARY KEY (uuid)
);

ALTER TABLE ${ADDB_SCHEMA}.person ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS person_policy_select ON ${ADDB_SCHEMA}.person;
CREATE POLICY person_policy_select ON ${ADDB_SCHEMA}.person
FOR SELECT
--  All persons publicly SELECTable if no sub/role requirement,
-- otherwise the subs_for_select or roles_for_select indicate a required
-- sub/role for the record.
USING (
    (
    owner_sub IS NOT NULL
    AND (
        (
        --no sub or role requirement for record
        subs_for_select = '[]'::jsonb AND roles_for_select = '[]'::jsonb
        )
        OR
        (
        -- user is current owner
        owner_sub = current_setting('request.jwt.claims', true)::json->>'sub'
        )
        OR
        (
        --meets sub or requirement for record
        subs_for_select::jsonb ? (current_setting('request.jwt.claims', true)::json->>'sub')::text
        )
        OR
        (
        --meets role requirement for record
        roles_for_select::jsonb ?| public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' )
        )
    )
    )
);

DROP POLICY IF EXISTS person_policy_insert ON ${ADDB_SCHEMA}.person;
CREATE POLICY person_policy_insert ON ${ADDB_SCHEMA}.person
FOR INSERT
--  persons INSERTable if no JWT claims, or if claim's sub matches owner
WITH CHECK (
    (
    current_setting('request.jwt.claims', true) IS NOT NULL AND
    owner_sub IS NOT NULL AND
    owner_sub = current_setting('request.jwt.claims', true)::json->>'sub'
    )
);

DROP POLICY IF EXISTS person_policy_update ON ${ADDB_SCHEMA}.person;
CREATE POLICY person_policy_update ON ${ADDB_SCHEMA}.person
FOR UPDATE
--  persons UPDATEable if no JWT claims, or if claim's sub matches owner
USING (
    (
    current_setting('request.jwt.claims', true) IS NOT NULL AND
    (
        -- User is the proper owner
        (
        owner_sub IS NOT NULL AND
        owner_sub = current_setting('request.jwt.claims', true)::json->>'sub'
        ) OR
        -- User is included in the subs_for_update
        (
        subs_for_update IS NOT NULL AND
        subs_for_update::jsonb ? (current_setting('request.jwt.claims', true)::json->>'sub')::text
        ) OR
        -- User's roles intersect with roles_for_update
        (
        roles_for_update IS NOT NULL AND
        roles_for_update::jsonb ?| public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' )
        ) OR
        -- User is marked as superadmin
        (
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
        )
    ) AND
    (
        lock_sub IS NULL OR
        (
        lock_sub IS NOT NULL AND lock_sub = current_setting('request.jwt.claims', true)::json->>'sub'
        ) OR
        -- User is marked as ${ADDB_SUPERADMIN_ENTITLEMENT} superadmin
        (
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
        )
    )
    )
)
-- update policy requires both USING *and* WITH_CHECK, as the USING
-- decides which rows are updateable in the first place, and the
-- WITH_CHECK determines if the new updates fit with the policy (after
-- being approved by the USING expression)
WITH CHECK (
    (
    current_setting('request.jwt.claims', true) IS NOT NULL AND
    (
        -- User is the proper owner
        (
        owner_sub IS NOT NULL AND
        owner_sub = current_setting('request.jwt.claims', true)::json->>'sub'
        ) OR
        -- User is included in the subs_for_update
        (
        subs_for_update IS NOT NULL AND
        subs_for_update::jsonb ? (current_setting('request.jwt.claims', true)::json->>'sub')::text
        ) OR
        -- User's roles intersect with roles_for_update
        (
        roles_for_update IS NOT NULL AND
        roles_for_update::jsonb ?| public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' )
        ) OR
        -- User is marked as superadmin
        (
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
        )
    ) AND
    (
        lock_sub IS NULL OR
        (
        lock_sub IS NOT NULL AND lock_sub = current_setting('request.jwt.claims', true)::json->>'sub'
        ) OR
        -- User is marked as superadmin
        (
        public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' ) @> array['${ADDB_SUPERADMIN_ENTITLEMENT}']
        )
    )
    )
);

DROP POLICY IF EXISTS person_policy_delete ON ${ADDB_SCHEMA}.person;
CREATE POLICY person_policy_delete ON ${ADDB_SCHEMA}.person
FOR DELETE
--  persons DELETEable if no JWT claims, or if claim's sub matches owner
USING (
    (
    current_setting('request.jwt.claims', true) IS NOT NULL AND
    owner_sub IS NOT NULL AND
    owner_sub = current_setting('request.jwt.claims', true)::json->>'sub' AND
    (
        lock_sub IS NULL
        -- record should not be deletable if it is still locked.
    )
    )
);

CREATE OR REPLACE FUNCTION person_insert_update_trigger() RETURNS TRIGGER AS $$
BEGIN
    IF current_setting('request.jwt.claims', true) IS NOT NULL THEN
    IF OLD.owner_sub IS NOT NULL THEN
        -- Don't update original if it was originally set.
        NEW.owner_sub = OLD.owner_sub;
    ELSE
        --Otherwise, owner will be the current sub
        NEW.owner_sub := current_setting('request.jwt.claims', true)::json->>'sub';
    END IF;
    -- Reject update to subs_for_update or roles_for_update when not the
    -- owner of the record
    IF NEW.owner_sub != current_setting('request.jwt.claims', true)::json->>'sub' THEN
        IF NEW.subs_for_update <> OLD.subs_for_update and  THEN
            RAISE EXCEPTION 'Changing "subs_for_update" is not allowed.';
        END IF;
        IF NEW.roles_for_update <> OLD.roles_for_update and  THEN
            RAISE EXCEPTION 'Changing "roles_for_update" is not allowed.';
        END IF;
    END IF;
    END IF;

    -- Maintain updated_at/created_at
    NEW.updated_at = now();
    IF OLD.created_at IS NOT NULL THEN
    NEW.created_at = OLD.created_at;
    END IF;

    -- Update locked_at when necessary
    IF OLD.lock_sub IS NULL AND NEW.lock_sub IS NOT NULL THEN
    NEW.locked_at = now();
    END IF;
    IF OLD.lock_sub IS NOT NULL AND NEW.lock_sub IS NULL THEN
    NEW.locked_at = null;
    END IF;

    --Custom handling of JSON schema constraint, raising a check_violation error
    --if schema doesn't match (along with list of errors)
    IF NOT jsonschema_is_valid((NEW.json_schema)::json) THEN
        RAISE sqlstate 'PT400' USING
            message = 'json_schema_invalid',
            detail = 'The schema submitted does not appear to be a valid JSON schema',
            hint = 'Check the JSON schema you submitted for errors';
    END IF;

    IF NOT jsonb_matches_schema((NEW.json_schema)::json, (NEW.data)::jsonb) THEN
        RAISE sqlstate 'PGRST' USING
            message = json_build_object(
                -- 'code' must be present, and also a string
                'code', 'PT400',
                'message', 'json_data_invalid',
                'details', 'JSON data is invalid according to the incoming schema',
                -- *Annoying*, but PostgREST validates that hint is a string.
                'hint', to_json(
                    jsonschema_validation_errors(
                        (NEW.json_schema)::json,
                        (NEW.data)::json
                    )
                )::text
            ),
            detail = json_build_object(
                -- 'status' must be present, and a number
                'status', 400,
                -- 'header' must also be present, and an empty object
                'headers', '{}'::json
            );
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE TRIGGER trigger_person_insert_update
BEFORE INSERT OR UPDATE ON ${ADDB_SCHEMA}.person
FOR EACH ROW
EXECUTE FUNCTION person_insert_update_trigger();

ALTER TABLE ${ADDB_SCHEMA}.person
DROP CONSTRAINT IF EXISTS person_addl_subs_and_roles_are_valid;

ALTER TABLE ${ADDB_SCHEMA}.person
ADD CONSTRAINT person_addl_subs_and_roles_are_valid
CHECK (
    jsonb_matches_schema( '{"type":"array","items":{"type": "string"}}'::json, subs_for_select::jsonb )
    AND
    jsonb_matches_schema( '{"type":"array","items":{"type": "string"}}'::json, roles_for_select::jsonb )
    AND
    jsonb_matches_schema( '{"type":"array","items":{"type": "string"}}'::json, subs_for_update::jsonb )
    AND
    jsonb_matches_schema( '{"type":"array","items":{"type": "string"}}'::json, roles_for_update::jsonb )
);

ALTER TABLE ${ADDB_SCHEMA}.person
DROP CONSTRAINT IF EXISTS person_owner_sub_non_empty_string;

ALTER TABLE ${ADDB_SCHEMA}.person
ADD CONSTRAINT person_owner_sub_non_empty_string
CHECK (
    owner_sub != ''
);

ALTER TABLE ${ADDB_SCHEMA}.person
DROP CONSTRAINT IF EXISTS person_lock_sub_non_empty_string;

ALTER TABLE ${ADDB_SCHEMA}.person
ADD CONSTRAINT person_lock_sub_non_empty_string
CHECK (
    lock_sub IS NULL OR (lock_sub IS NOT NULL AND lock_sub != '')
);

DROP INDEX IF EXISTS person_owner_sub_idx;
CREATE INDEX IF NOT EXISTS person_owner_sub_idx ON ${ADDB_SCHEMA}.person (owner_sub);

DROP INDEX IF EXISTS person_data_sub_idx;
CREATE INDEX IF NOT EXISTS person_data_sub_idx ON ${ADDB_SCHEMA}.person ((data->>'sub'));
