CREATE TABLE IF NOT EXISTS ${ADDB_SCHEMA}.document (
    "uuid" uuid NOT NULL DEFAULT uuid_generate_v4(),
    "owner_sub" VARCHAR(64) NOT NULL,
    "lock_sub" VARCHAR(64) NULL,
    "locked_at" timestamptz NULL,
    "subs_for_select" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "roles_for_select" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "subs_for_update" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "roles_for_update" jsonb NOT NULL DEFAULT '[]'::jsonb,
    "data" jsonb NOT NULL DEFAULT '{}'::jsonb,
    "attrs" jsonb NOT NULL DEFAULT '{}'::jsonb,
    "created_at" timestamptz NOT NULL DEFAULT now(),
    "updated_at" timestamptz NOT NULL DEFAULT now(),
    "label" varchar(256) NOT NULL DEFAULT '',
    "description" text NOT NULL DEFAULT '',
    "comments" text NOT NULL DEFAULT '',
    "published" boolean NOT NULL DEFAULT false,
    "published_at" timestamptz NULL,
    "object_type_uuid" uuid REFERENCES ${ADDB_SCHEMA}.object_type(uuid) ON DELETE SET NULL,
    CONSTRAINT document_pkey PRIMARY KEY (uuid)
);

-- Working with an existing table, we have to tread carefully when trying to
-- create a not-null column.
ALTER TABLE ${ADDB_SCHEMA}.document
ADD COLUMN IF NOT EXISTS slug varchar(256) NULL;

UPDATE ${ADDB_SCHEMA}.document SET slug = uuid::text WHERE slug IS NULL;

ALTER TABLE ${ADDB_SCHEMA}.document
ALTER COLUMN slug SET NOT NULL;

ALTER TABLE ${ADDB_SCHEMA}.document
DROP CONSTRAINT IF EXISTS document_type_slug_uniq;

ALTER TABLE ${ADDB_SCHEMA}.document ADD CONSTRAINT document_type_slug_uniq UNIQUE (object_type_uuid, slug);

DROP INDEX IF EXISTS asset_docs_typ_slug_idx;
CREATE INDEX IF NOT EXISTS asset_docs_typ_slug_idx ON ${ADDB_SCHEMA}.document (object_type_uuid, slug);

-- Adds geometry column
ALTER TABLE ${ADDB_SCHEMA}.document
ADD COLUMN IF NOT EXISTS geom geometry NULL;

-- Old view definitions can depend on legacy document columns. Drop and
-- recreate them later so column migrations can run safely.
DROP VIEW IF EXISTS ${ADDB_SCHEMA}.document_with_permissions;
DROP VIEW IF EXISTS ${ADDB_SCHEMA}.document_for_update;
DROP VIEW IF EXISTS ${ADDB_SCHEMA}.document_revision;

ALTER TABLE ${ADDB_SCHEMA}.document
DROP COLUMN IF EXISTS "public";

ALTER TABLE ${ADDB_SCHEMA}.document
ADD COLUMN IF NOT EXISTS "published" boolean NULL DEFAULT false;

UPDATE ${ADDB_SCHEMA}.document SET "published" = false WHERE "published" IS NULL;

ALTER TABLE ${ADDB_SCHEMA}.document
ALTER COLUMN "published" SET NOT NULL;

ALTER TABLE ${ADDB_SCHEMA}.document
ADD COLUMN IF NOT EXISTS "published_at" timestamptz NULL;

UPDATE ${ADDB_SCHEMA}.document
SET published_at = now()
WHERE published AND published_at IS NULL;

DROP INDEX IF EXISTS asset_docs_geom_idx;
CREATE INDEX asset_docs_geom_idx ON ${ADDB_SCHEMA}.document USING gist (geom);

ALTER TABLE ${ADDB_SCHEMA}.document ENABLE ROW LEVEL SECURITY;

--Enable row-level table versioning for document
SELECT
table_version.ver_enable_versioning('${ADDB_SCHEMA}', 'document' )
WHERE
NOT table_version.ver_is_table_versioned('${ADDB_SCHEMA}', 'document');

DROP POLICY IF EXISTS document_policy_select ON ${ADDB_SCHEMA}.document;
CREATE POLICY document_policy_select ON ${ADDB_SCHEMA}.document
FOR SELECT
--  Published documents are SELECTable by everyone. Non-published documents are
--  SELECTable only for users with modify-level permission.
USING (
    "published"
    OR ${ADDB_SCHEMA}.can_modify_document(
        owner_sub,
        subs_for_update,
        roles_for_update,
        lock_sub
    )
);

DROP POLICY IF EXISTS document_policy_insert ON ${ADDB_SCHEMA}.document;
CREATE POLICY document_policy_insert ON ${ADDB_SCHEMA}.document
FOR INSERT
--  documents INSERTable if no JWT claims, or if claim's sub matches owner
WITH CHECK (
    (
    current_setting('request.jwt.claims', true) IS NOT NULL AND
    owner_sub IS NOT NULL AND
    owner_sub = current_setting('request.jwt.claims', true)::json->>'sub'
    )
);

DROP POLICY IF EXISTS document_policy_update ON ${ADDB_SCHEMA}.document;
CREATE POLICY document_policy_update ON ${ADDB_SCHEMA}.document
FOR UPDATE
--  documents UPDATEable if no JWT claims, or if claim's sub matches owner
USING (
    ${ADDB_SCHEMA}.can_modify_document(
        owner_sub,
        subs_for_update,
        roles_for_update,
        lock_sub
    )
)
-- update policy requires both USING *and* WITH_CHECK, as the USING
-- decides which rows are updateable in the first place, and the
-- WITH_CHECK determines if the new updates fit with the policy (after
-- being approved by the USING expression)
WITH CHECK (
    ${ADDB_SCHEMA}.can_modify_document(
        owner_sub,
        subs_for_update,
        roles_for_update,
        lock_sub
    )
);

DROP POLICY IF EXISTS document_policy_delete ON ${ADDB_SCHEMA}.document;
CREATE POLICY document_policy_delete ON ${ADDB_SCHEMA}.document
FOR DELETE
--  documents DELETEable if no JWT claims, or if claim's sub matches owner
USING (
    (
    current_setting('request.jwt.claims', true) IS NOT NULL AND
    owner_sub IS NOT NULL AND
    owner_sub = current_setting('request.jwt.claims', true)::json->>'sub' AND
    (
        lock_sub IS NULL
        -- record should not be deletable if it is still locked.
    )
    )
);


CREATE OR REPLACE FUNCTION asset_doc_insert_update_trigger() RETURNS TRIGGER AS $$

BEGIN
    IF current_setting('request.jwt.claims', true) IS NOT NULL THEN
        IF OLD.owner_sub IS NOT NULL THEN
            -- Don't update original if it was originally set.
            NEW.owner_sub = OLD.owner_sub;
        ELSE
            --Otherwise, owner will be the current sub
            NEW.owner_sub := current_setting('request.jwt.claims', true)::json->>'sub';
        END IF;
        -- Reject update to subs_for_update or roles_for_update when not the
        -- owner of the record
        IF NEW.owner_sub != current_setting('request.jwt.claims', true)::json->>'sub' THEN
            IF NEW.subs_for_update <> OLD.subs_for_update and  THEN
                RAISE EXCEPTION 'Changing "subs_for_update" is not allowed.';
            END IF;
            IF NEW.roles_for_update <> OLD.roles_for_update and  THEN
                RAISE EXCEPTION 'Changing "roles_for_update" is not allowed.';
            END IF;
        END IF;
    END IF;

    -- Maintain updated_at/created_at
    NEW.updated_at = now();
    IF OLD.created_at IS NOT NULL THEN
        NEW.created_at = OLD.created_at;
    END IF;

    -- Update locked_at when necessary
    IF OLD.lock_sub IS NULL AND NEW.lock_sub IS NOT NULL THEN
        NEW.locked_at = now();
    END IF;

    IF OLD.lock_sub IS NOT NULL AND NEW.lock_sub IS NULL THEN
        NEW.locked_at = null;
    END IF;

    -- Maintain published_at from published state.
    IF TG_OP = 'INSERT' THEN
        IF NEW.published THEN
            NEW.published_at = COALESCE(NEW.published_at, now());
        ELSE
            NEW.published_at = NULL;
        END IF;
    ELSIF TG_OP = 'UPDATE' THEN
        IF NEW.published IS DISTINCT FROM OLD.published THEN
            IF NEW.published THEN
                NEW.published_at = now();
            ELSE
                NEW.published_at = NULL;
            END IF;
        ELSIF NEW.published AND NEW.published_at IS NULL THEN
            NEW.published_at = COALESCE(OLD.published_at, now());
        ELSIF NOT NEW.published THEN
            NEW.published_at = NULL;
        END IF;
    END IF;

    IF NEW.slug IS NULL THEN
        IF NEW.uuid IS NOT NULL THEN
            NEW.slug = (NEW.uuid)::text;
        END IF;
    END IF;

    IF NOT jsonb_matches_schema(
        (
            (
                ${ADDB_SCHEMA}.get_default_schema_at_object_type_uuid(NEW.object_type_uuid)
            ).json_schema
        )::json,
        (NEW.data)::jsonb
    ) THEN
        RAISE sqlstate 'PGRST' USING
            message = json_build_object(
                -- 'code' must be present, and also a string
                'code', 'PT400',
                'message', 'json_data_invalid',
                'details', 'JSON data is invalid according to the incoming schema',
                -- *Annoying*, but PostgREST validates that hint is a string.
                'hint', to_json(
                    jsonschema_validation_errors(
                        (${ADDB_SCHEMA}.get_default_schema_at_object_type_uuid(NEW.object_type_uuid)).json_schema::json,
                        (NEW.data)::json
                    )
                )::text
            ),
            detail = json_build_object(
                -- 'status' must be present, and a number
                'status', 400,
                -- 'header' must also be present, and an empty object
                'headers', '{}'::json
            );
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE TRIGGER trigger_asset_doc_insert_update
BEFORE INSERT OR UPDATE ON ${ADDB_SCHEMA}.document
FOR EACH ROW
EXECUTE FUNCTION asset_doc_insert_update_trigger();

ALTER TABLE ${ADDB_SCHEMA}.document
DROP CONSTRAINT IF EXISTS asset_doc_addl_subs_and_roles_are_valid;

ALTER TABLE ${ADDB_SCHEMA}.document
ADD CONSTRAINT asset_doc_addl_subs_and_roles_are_valid
CHECK (
    jsonb_matches_schema( '{"type":"array","items":{"type": "string"}}'::json, subs_for_select::jsonb )
    AND
    jsonb_matches_schema( '{"type":"array","items":{"type": "string"}}'::json, roles_for_select::jsonb )
    AND
    jsonb_matches_schema( '{"type":"array","items":{"type": "string"}}'::json, subs_for_update::jsonb )
    AND
    jsonb_matches_schema( '{"type":"array","items":{"type": "string"}}'::json, roles_for_update::jsonb )
);

ALTER TABLE ${ADDB_SCHEMA}.document
DROP CONSTRAINT IF EXISTS asset_doc_owner_sub_non_empty_string;

ALTER TABLE ${ADDB_SCHEMA}.document
ADD CONSTRAINT asset_doc_owner_sub_non_empty_string
CHECK (
    owner_sub != ''
);

ALTER TABLE ${ADDB_SCHEMA}.document
DROP CONSTRAINT IF EXISTS asset_doc_lock_sub_non_empty_string;

ALTER TABLE ${ADDB_SCHEMA}.document
ADD CONSTRAINT asset_doc_lock_sub_non_empty_string
CHECK (
    lock_sub IS NULL OR (lock_sub IS NOT NULL AND lock_sub != '')
);

DROP INDEX IF EXISTS asset_docs_owner_sub_idx;
CREATE INDEX IF NOT EXISTS asset_docs_owner_sub_idx ON ${ADDB_SCHEMA}.document (owner_sub);

-- Use security_invoker so base-table RLS evaluates as the caller, not the
-- view owner. This prevents private rows from leaking via view access.
CREATE OR REPLACE VIEW ${ADDB_SCHEMA}.document_with_permissions with (security_barrier, security_invoker = true) as (
SELECT
    d.*,
    ${ADDB_SCHEMA}.can_modify_document(
        d.owner_sub,
        d.subs_for_update,
        d.roles_for_update,
        d.lock_sub
    ) AS can_modify
FROM
    ${ADDB_SCHEMA}.document d
);

GRANT SELECT ON ${ADDB_SCHEMA}.document_with_permissions TO ${ADDB_READ_USER};
GRANT SELECT ON ${ADDB_SCHEMA}.document_with_permissions TO ${ADDB_RW_USER};

CREATE OR REPLACE VIEW ${ADDB_SCHEMA}.document_for_update with (security_barrier, security_invoker = true) as (
SELECT
    d.*
FROM
    ${ADDB_SCHEMA}.document d
WHERE
    ${ADDB_SCHEMA}.can_modify_document(
        d.owner_sub,
        d.subs_for_update,
        d.roles_for_update,
        d.lock_sub
    )
);

-- Grant access to the table version records
GRANT SELECT ON table_version.asset_docs_document_revision TO ${ADDB_READ_USER};
GRANT SELECT ON table_version.asset_docs_document_revision TO ${ADDB_RW_USER};

CREATE OR REPLACE VIEW ${ADDB_SCHEMA}.document_revision with (security_barrier, security_invoker = true) as (
SELECT
    dr.*
FROM
    ${ADDB_SCHEMA}.document d
INNER JOIN
    table_version.asset_docs_document_revision dr
ON
    d."uuid" = dr."uuid"
WHERE
    (
    d.owner_sub IS NOT NULL
    AND (
        (
        --no sub or role requirement for record
        d.subs_for_select = '[]'::jsonb AND d.roles_for_select = '[]'::jsonb
        )
        OR
        (
        -- user is current owner
        d.owner_sub = current_setting('request.jwt.claims', true)::json->>'sub'
        )
        OR
        (
        --meets sub or requirement for record
        d.subs_for_select::jsonb ? (current_setting('request.jwt.claims', true)::json->>'sub')::text
        )
        OR
        (
        --meets role requirement for record
        d.roles_for_select::jsonb ?| public.jsonb_array_to_text_array( current_setting('request.jwt.claims', true)::jsonb->'roles' )
        )
    )
    )
);

GRANT SELECT ON ${ADDB_SCHEMA}.document_revision TO ${ADDB_READ_USER};
GRANT SELECT ON ${ADDB_SCHEMA}.document_revision TO ${ADDB_RW_USER};