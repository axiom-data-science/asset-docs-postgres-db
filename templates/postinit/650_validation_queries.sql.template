-- Validation checks for permission behavior against 60+ mock data.
-- This script is intended for local/dev verification and exits with an error
-- when expected permission behavior changes.

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}.run_document_permission_validation()
RETURNS jsonb
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
AS $$
DECLARE
    subject_cases jsonb;
    subject_failures integer;
    view_cases jsonb;
    view_failures integer;
    update_count_cases jsonb;
    update_count_failures integer;
    anonymous_visible_count bigint;
    minimum_anonymous_visible_count bigint := 1;
    result jsonb;
BEGIN
    WITH cases AS (
        SELECT *
        FROM (
            VALUES
                -- owner checks
                ('seed-owner-only'::text, 'seed-alice-sub'::text, ARRAY[]::text[], true),
                ('seed-owner-only'::text, 'seed-bob-sub'::text, ARRAY[]::text[], false),

                -- subs_for_update checks
                ('seed-sub-grant'::text, 'seed-alice-sub'::text, ARRAY[]::text[], true),
                ('seed-sub-grant'::text, 'seed-carol-sub'::text, ARRAY[]::text[], false),

                -- roles_for_update checks
                ('seed-role-grant'::text, 'seed-eve-sub'::text, ARRAY['editor']::text[], true),
                ('seed-role-grant'::text, 'seed-eve-sub'::text, ARRAY['viewer']::text[], false),

                -- lock behavior checks
                ('seed-locked-by-owner'::text, 'seed-eve-sub'::text, ARRAY['editor']::text[], false),
                ('seed-locked-by-owner'::text, 'seed-dave-sub'::text, ARRAY['editor']::text[], true),
                ('seed-locked-by-qa'::text, 'seed-qa-user-sub'::text, ARRAY['qa']::text[], true),
                ('seed-locked-by-qa'::text, 'seed-qa-peer-sub'::text, ARRAY['qa']::text[], false),

                -- superadmin override checks
                ('seed-locked-by-owner'::text, 'seed-admin-sub'::text, ARRAY['${ADDB_SUPERADMIN_ENTITLEMENT}']::text[], true)
        ) AS t(slug, subject_sub, subject_roles, expected)
    ),
    evaluated AS (
        SELECT
            c.slug,
            c.subject_sub,
            c.subject_roles,
            c.expected,
            ${ADDB_SCHEMA}.can_modify_document_for_subject(
                d.owner_sub,
                d.subs_for_update,
                d.roles_for_update,
                d.lock_sub,
                c.subject_sub,
                c.subject_roles
            ) AS actual
        FROM
            cases c
        INNER JOIN
            ${ADDB_SCHEMA}.document d
        ON
            d.slug = c.slug
    )
    SELECT
        COALESCE(
            jsonb_agg(
                jsonb_build_object(
                    'slug', slug,
                    'subject_sub', subject_sub,
                    'subject_roles', subject_roles,
                    'expected', expected,
                    'actual', actual,
                    'passed', actual IS NOT DISTINCT FROM expected
                )
                ORDER BY slug, subject_sub
            ),
            '[]'::jsonb
        ),
        COUNT(*) FILTER (WHERE actual IS DISTINCT FROM expected)
    INTO subject_cases, subject_failures
    FROM evaluated;

    WITH cases AS (
        SELECT *
        FROM (
            VALUES
                ('{"sub":"seed-alice-sub","roles":[]}'::text, 'seed-owner-only'::text, true),
                ('{"sub":"seed-alice-sub","roles":[]}'::text, 'seed-sub-grant'::text, true),
                ('{"sub":"seed-alice-sub","roles":[]}'::text, 'seed-role-grant'::text, false),
                ('{"sub":"seed-qa-user-sub","roles":["qa"]}'::text, 'seed-locked-by-qa'::text, true),
                ('{"sub":"seed-qa-peer-sub","roles":["qa"]}'::text, 'seed-locked-by-qa'::text, false),
                ('{"sub":"seed-admin-sub","roles":["${ADDB_SUPERADMIN_ENTITLEMENT}"]}'::text, 'seed-locked-by-owner'::text, true)
        ) AS t(claims_json, slug, expected)
    ),
    evaluated AS (
        SELECT
            c.claims_json,
            c.slug,
            c.expected,
            ${ADDB_SCHEMA}.can_modify_document_for_subject(
                d.owner_sub,
                d.subs_for_update,
                d.roles_for_update,
                d.lock_sub,
                c.claims_json::jsonb->>'sub',
                public.jsonb_array_to_text_array(c.claims_json::jsonb->'roles')
            ) AS actual
        FROM
            cases c
        INNER JOIN
            ${ADDB_SCHEMA}.document d
        ON
            d.slug = c.slug
    )
    SELECT
        COALESCE(
            jsonb_agg(
                jsonb_build_object(
                    'slug', slug,
                    'claims', claims_json,
                    'expected', expected,
                    'actual', actual,
                    'passed', actual IS NOT DISTINCT FROM expected
                )
                ORDER BY slug, claims_json
            ),
            '[]'::jsonb
        ),
        COUNT(*) FILTER (WHERE actual IS DISTINCT FROM expected)
    INTO view_cases, view_failures
    FROM evaluated;

    update_count_cases := jsonb_build_array(
        jsonb_build_object(
            'subject', 'seed-alice-sub',
            'expected', 2,
            'actual', (
                SELECT count(*)
                FROM ${ADDB_SCHEMA}.document d
                WHERE d.slug IN (
                    'seed-owner-only',
                    'seed-sub-grant',
                    'seed-role-grant',
                    'seed-locked-by-owner',
                    'seed-locked-by-qa'
                )
                AND ${ADDB_SCHEMA}.can_modify_document_for_subject(
                    d.owner_sub,
                    d.subs_for_update,
                    d.roles_for_update,
                    d.lock_sub,
                    'seed-alice-sub',
                    ARRAY[]::text[]
                )
            ),
            'passed', (
                SELECT count(*)
                FROM ${ADDB_SCHEMA}.document d
                WHERE ${ADDB_SCHEMA}.can_modify_document_for_subject(
                    d.owner_sub,
                    d.subs_for_update,
                    d.roles_for_update,
                    d.lock_sub,
                    'seed-alice-sub',
                    ARRAY[]::text[]
                )
                AND d.slug IN (
                    'seed-owner-only',
                    'seed-sub-grant',
                    'seed-role-grant',
                    'seed-locked-by-owner',
                    'seed-locked-by-qa'
                )
            ) = 2
        ),
        jsonb_build_object(
            'subject', 'seed-admin-sub',
            'expected', 5,
            'actual', (
                SELECT count(*)
                FROM ${ADDB_SCHEMA}.document d
                WHERE d.slug IN (
                    'seed-owner-only',
                    'seed-sub-grant',
                    'seed-role-grant',
                    'seed-locked-by-owner',
                    'seed-locked-by-qa'
                )
                AND ${ADDB_SCHEMA}.can_modify_document_for_subject(
                    d.owner_sub,
                    d.subs_for_update,
                    d.roles_for_update,
                    d.lock_sub,
                    'seed-admin-sub',
                    ARRAY['${ADDB_SUPERADMIN_ENTITLEMENT}']::text[]
                )
            ),
            'passed', (
                SELECT count(*)
                FROM ${ADDB_SCHEMA}.document d
                WHERE ${ADDB_SCHEMA}.can_modify_document_for_subject(
                    d.owner_sub,
                    d.subs_for_update,
                    d.roles_for_update,
                    d.lock_sub,
                    'seed-admin-sub',
                    ARRAY['${ADDB_SUPERADMIN_ENTITLEMENT}']::text[]
                )
                AND d.slug IN (
                    'seed-owner-only',
                    'seed-sub-grant',
                    'seed-role-grant',
                    'seed-locked-by-owner',
                    'seed-locked-by-qa'
                )
            ) = 5
        )
    );

    SELECT COUNT(*)
    INTO update_count_failures
    FROM jsonb_array_elements(update_count_cases) AS c
    WHERE NOT COALESCE((c->>'passed')::boolean, false);

    SELECT count(*)
    INTO anonymous_visible_count
    FROM ${ADDB_SCHEMA}.document d
    WHERE
        d.published
        OR ${ADDB_SCHEMA}.can_modify_document_for_subject(
            d.owner_sub,
            d.subs_for_update,
            d.roles_for_update,
            d.lock_sub,
            NULL,
            NULL
        );

    result := jsonb_build_object(
        'summary', jsonb_build_object(
            'passed',
                subject_failures = 0
                AND view_failures = 0
                AND update_count_failures = 0
                AND anonymous_visible_count >= minimum_anonymous_visible_count,
            'subject_failures', subject_failures,
            'view_failures', view_failures,
            'update_count_failures', update_count_failures,
            'anonymous_visible_count', anonymous_visible_count,
            'minimum_anonymous_visible_count', minimum_anonymous_visible_count
        ),
        'checks', jsonb_build_object(
            'subject_permission_cases', subject_cases,
            'document_with_permissions_cases', view_cases,
            'document_for_update_count_cases', update_count_cases
        )
    );

    RETURN result;
END;
$$;

GRANT EXECUTE ON FUNCTION ${ADDB_SCHEMA}.run_document_permission_validation() TO ${ADDB_READ_USER};
GRANT EXECUTE ON FUNCTION ${ADDB_SCHEMA}.run_document_permission_validation() TO ${ADDB_RW_USER};

DO $$
DECLARE
    validation_result jsonb;
BEGIN
    validation_result := ${ADDB_SCHEMA}.run_document_permission_validation();

    IF NOT COALESCE((validation_result->'summary'->>'passed')::boolean, false) THEN
        RAISE EXCEPTION USING
            MESSAGE = 'Permission validation failed',
            DETAIL = validation_result::text;
    END IF;
END;
$$ LANGUAGE plpgsql;
