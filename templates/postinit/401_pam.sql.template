-- Default object types, schemas, and forms for PAM (Passive Acoustic Monitoring)

-- Remove the legacy (single) PAM type only when it has no documents (also deletes schemas n forms)
DELETE FROM ${ADDB_SCHEMA}.object_type AS ot
WHERE ot.slug = 'pam'
  AND NOT EXISTS (
      SELECT 1
      FROM ${ADDB_SCHEMA}.document AS d
      WHERE d.object_type_uuid = ot.uuid
  );

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}.pam_project_object_schema_json_schema()
RETURNS jsonb AS $function$
BEGIN
  RETURN '
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PAM project",
  "description": "A pam project",
  "type": "object",
  "properties": {
    "project": { "type": "string", "title": "Project", "description": "Project name", "minLength": 1 },
    "dataSubmitter": { "type": "string", "title": "Data Submitter", "description": "Person responsible for submitting the data" },
    "relatedProjects": {
      "type": "array",
      "title": "Related Projects",
      "description": "Overarching projects for which the data were collected",
      "items": { "type": "string", "minLength": 1 }
    },
    "contributor": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "title": "Contributor role",
            "oneOf": [
              { 
                "const": "funder", 
                "title": "Funder", 
                "description": "Organizations that funded the data collection" 
              },
              { 
                "const": "scientist", 
                "title": "Scientist", 
                "description": "People involved in collecting or processing the data" 
              }
            ]
          },
          "name": { "type": "string", "title": "Name" },
          "phone": { "type": "string", "format": "phone", "title": "Telephone (primary)" },
          "email": { "type": "string", "format": "email", "title": "Email" },
          "url": { "type": "string", "title": "URL" },
          "affiliation": { "type": "string", "title": "Organization" }
        }
      }
    }
  },
  "required": ["project", "dataSubmitter"]
}
'::jsonb;
END;
$function$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}.pam_site_object_schema_json_schema()
RETURNS jsonb AS $function$
BEGIN
  RETURN '
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PAM Site",
  "description": "A PAM site",
  "type": "object",
  "properties": {
    "siteOrCruiseName": { "type": "string", "title": "Site or Cruise Name", "description": "Location name, cruise ID, or site" },
    "alternateSiteName": { "type": "string", "title": "Alternate Site Name", "description": "Alternate site label" },
    "platform": { "type": "string", "title": "Platform", "description": "Platform on which the acoustic recorders were deployed", "minLength": 1 },
    "locationDetail": {
      "type": "object",
      "title": "Location Detail",
      "oneOf": [
        {
          "title": "Stationary Marine Location",
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "stationary_marine" },
            "seaArea": { "type": "string", "title": "Sea Area" },
            "deploymentLocation": { "$ref": "#/definitions/marineInstrumentLocation", "title": "Deployment Location" },
            "recoveryLocation": { "$ref": "#/definitions/marineInstrumentLocation", "title": "Recovery Location" }
          },
          "required": ["type"]
        },
        {
          "title": "Stationary Terrestrial Location",
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "stationary_terrestrial" },
            "latitude": { "type": "number", "title": "Latitude"},
            "longitude": { "type": "number", "title": "Longitude" },
            "surfaceElevation": { "type": "number", "title": "Surface Elevation" },
            "instrumentElevation": { "type": "number", "title": "Instrument Elevation" }
          },
          "required": ["type"]
        },
        {
          "title": "Mobile Marine Location",
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "mobile_marine" },
            "seaArea": { "type": "string", "title": "Sea Area" },
            "locationDerivationDescription": { "type": "string", "title": "Location Derivation Description", "minLength": 1 },
            "navigationFileURIList": { "type": "array", "title": "Navigation Files", "items": { "type": "string", "format": "uri" }, "minItems": 1 }
          },
          "required": ["type"]
        },
        {
          "title": "Multipoint Stationary Marine Location",
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "multipoint_stationary_marine" },
            "seaArea": { "type": "string", "title": "Sea Area" },
            "locations": { "type": "array", "title": "Locations", "items": { "$ref": "#/definitions/marineInstrumentLocation" }, "minItems": 1 }
          },
          "required": ["type"]
        }
      ]
    }
  },
  "definitions": {
    "marineInstrumentLocation": {
      "type": "object",
      "properties": {
        "latitude": { "type": "number", "title": "Latitude"},
        "longitude": { "type": "number", "title": "Longitude" },
        "seaFloorDepth": { "type": "number", "title": "Seafloor Depth", "exclusiveMaximum": 0 },
        "instrumentDepth": { "type": "number", "title": "Instrument Depth", "exclusiveMaximum": 0 }
      }
    }
  },
  "required": ["siteOrCruiseName","platform", "locationDetail"]
}
'::jsonb;
END;
$function$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}.pam_deployment_object_schema_json_schema()
RETURNS jsonb AS $function$
BEGIN
  RETURN '
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PAM Deployment",
  "description": "One deployment event including recordings and analyses",
  "type": "object",
  "properties": {
    "dataCollectionName": { "type": "string", "title": "Data Collection Name", "description": "Unique dataset name for the archive", "minLength": 1 },
    "averageFileLengthMinutes": { "type": "number", "title": "Average File Length (minutes)", "description": "Approximate average audio-file length used for aggregation", "minimum": 0 },
    "deploymentTitle": { "type": "string", "title": "Deployment Title", "description": "Title used in the dataset-level metadata record" },
    "deploymentDescription": { "type": "string", "title": "Deployment Description", "description": "Description of the data and its purpose" },
    "deploymentId": { "type": "string", "title": "Deployment ID", "description": "Deployment identifier at a site with multiple deployments" },
    "alternateDeploymentName": { "type": "string", "title": "Alternate Deployment Name", "description": "Alternate deployment label" },
    "instrument": { "type": "string", "title": "Instrument", "description": "Passive acoustic recorder used to collect data", "minLength": 1 },
    "instrumentId": { "type": "string", "title": "Instrument ID", "description": "Unique instrument identifier" },
    "sensitivityFlatValue": { "type": "number", "title": "Sensitivity Flat Value", "description": "Frequency-independent calibration sensitivity value" },
    "preDeploymentCalibrationDate": { "type": "string", "format": "date", "title": "Pre-Deployment Calibration Date" },
    "postDeploymentCalibrationDate": { "type": "string", "format": "date", "title": "Post-Deployment Calibration Date" },
    "calibrationState": {
      "type": "string",
      "title": "Calibration State",
      "enum": ["Factory Calibrated", "Calibrated Pre-Deployment", "Calibrated Post-Deployment", "Calibrated Pre & Post Deployment", "Not calibrated / not applicable"]
    },
    "calibrationDescription": { "type": "string", "title": "Calibration Description" },
    "sourceURI": { "type": "string", "format": "uri", "title": "Source URI", "description": "URI containing the audio files for this dataset" },
    "calibrationDocumentsURI": { "type": "string", "format": "uri", "title": "Calibration Documents URI" },
    "documentsURI": { "type": "string", "format": "uri", "title": "Documents URI" },
    "temperatureURI": { "type": "string", "format": "uri", "title": "Temperature Data URI" },
    "otherURI": { "type": "string", "format": "uri", "title": "Other Data URI" },
    "deploymentTime": { "type": "string", "format": "date-time", "title": "Deployment Time" },
    "recoveryTime": { "type": "string", "format": "date-time", "title": "Recovery Time" },
    "audioStartTime": { "type": "string", "format": "date-time", "title": "Audio Start Time" },
    "audioEndTime": { "type": "string", "format": "date-time", "title": "Audio End Time" },
    "comments": { "type": "string", "title": "Comments", "description": "Additional information useful to future data users" },
    "recordings": {
      "type": "array",
      "title": "Recordings",
      "items": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "array",
            "title": "Channels",
            "items": {
              "type": "object",
              "properties": {
                "startTime": { "type": "string", "format": "date-time", "title": "Start Time", "description": "Start time for this channel''s audio data" },
                "endTime": { "type": "string", "format": "date-time", "title": "End Time", "description": "End time for this channel''s audio data" },
                "sampleRates": {
                  "type": "array",
                  "title": "Sample Rate Intervals",
                  "items": {
                    "type": "object",
                    "properties": {
                      "startTime": { "type": "string", "format": "date-time", "title": "Start Time" },
                      "endTime": { "type": "string", "format": "date-time", "title": "End Time" },
                      "sampleRate": { "type": "number", "title": "Sample Rate (Hz)", "description": "Audio sample rate in hertz", "minimum": 0 },
                      "sampleBits": { "type": "integer", "title": "Sample Bits", "description": "Bit depth in bits per sample", "minimum": 0 }
                    }
                  }
                },
                "dutyCycles": {
                  "type": "array",
                  "title": "Duty Cycle Intervals",
                  "items": {
                    "type": "object",
                    "properties": {
                      "startTime": { "type": "string", "format": "date-time", "title": "Start Time" },
                      "endTime": { "type": "string", "format": "date-time", "title": "End Time" },
                      "duration": { "type": "number", "title": "Duration (seconds)", "description": "Continuous recording duration", "minimum": 0 },
                      "interval": { "type": "number", "title": "Interval (seconds)", "description": "Time between starts of consecutive recording periods", "minimum": 0 }
                    },
                    "required": ["duration", "interval"]
                  }
                }
              }
            }
          }
        },
        "required": ["channels"]
      }
    },
    "analyses": {
      "type": "array",
      "title": "Analyses",
      "items": {
        "type": "object",
        "properties": {
          "qualityAnalyst": { "type": "string", "title": "Quality Analyst", "description": "Person who performed the data quality assessment" },
          "qualityAssessmentDescription": { "type": "string", "title": "Quality Assessment Description", "description": "Overall description of the quality assessment" },
          "qualityEntries": {
            "type": "array",
            "title": "Quality Entries",
            "items": {
              "type": "object",
              "properties": {
                "startTime": { "type": "string", "format": "date-time", "title": "Start Time" },
                "endTime": { "type": "string", "format": "date-time", "title": "End Time" },
                "minFrequency": { "type": "number", "title": "Minimum Frequency (Hz)", "description": "Minimum frequency covered by the assessment", "minimum": 0 },
                "maxFrequency": { "type": "number", "title": "Maximum Frequency (Hz)", "description": "Maximum frequency covered by the assessment", "minimum": 0 },
                "qualityLevel": { "type": "string", "title": "Quality Level", "enum": ["unverified", "good", "compromised", "unusable"] },
                "comments": { "type": "string", "title": "Comments", "description": "Additional information about this quality interval" },
                "channelNumbers": { "type": "array", "title": "Channel Numbers", "description": "Channels to which this quality entry applies", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 }
              },
              "required": ["startTime", "endTime", "minFrequency", "maxFrequency", "qualityLevel", "channelNumbers"]
            }
          }
        }
      }
    }
  },
  "required": ["dataCollectionName", "averageFileLengthMinutes", "deploymentTitle", "deploymentDescription", "instrument", "sourceURI", "calibrationState", "sensitivityFlatValue", "recordings"]
}
'::jsonb;
END;
$function$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}.pam_project_form_schema_override_config()
RETURNS jsonb AS $function$
BEGIN
  RETURN '
{
  "id": "pam_project",
  "label": "PAM Project",
  "fields": [
    {
      "id": "wrap1",
      "type": "objectWrapper",
      "label": "",
      "layout": "grid2",
      "fields": [{ "prop": "project" }, { "prop": "dataSubmitter" }]
    },
    {
      "prop": "contributor[]",
      "fields": [
        { "prop": "contributor[].role", "label": "Role", "type": "select" },
        {
          "id": "contributor_contact_wrapper",
          "type": "objectWrapper",
          "layout": "grid2",
          "label": "",
          "settings": { "className": "p-0 bg-transparent" },
          "fields": [
            { "prop": "contributor[].name" },
            { "prop": "contributor[].phone" },
            { "prop": "contributor[].email" },
            { "prop": "contributor[].url" }
          ]
        }
      ]
    },
    { "prop": "relatedProjects[]" }
  ]
}
'::jsonb;
END;
$function$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}.pam_site_form_schema_override_config()
RETURNS jsonb AS $function$
BEGIN
  RETURN '
{
  "id": "pam_site",
  "label": "PAM site",
  "fields": [
    { "prop": "siteOrCruiseName" },
    {
      "id": "group-1",
      "type": "object",
      "label": "",
      "skip_path": true,
      "layout": "grid2",
      "settings": { "className": "pt-0" },
      "fields": [{ "prop": "alternateSiteName" }, { "prop": "platform" }]
    },
    { "prop": "locationDetail" }
  ]
}
'::jsonb;
END;
$function$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION ${ADDB_SCHEMA}.pam_deployment_form_schema_override_config()
RETURNS jsonb AS $function$
BEGIN
  RETURN '
{
  "id": "pam_deployment",
  "label": "PAM Deployment and Analyses",
  "pages": [
    {
      "id": "overview",
      "label": "Overview",
      "description": "Dataset identity and deployment details",
      "fields": [
        { "prop": "dataCollectionName" },
        { "prop": "averageFileLengthMinutes" },
        { "prop": "deploymentTitle" },
        { "prop": "deploymentDescription", "type": "long_text" },
        { "prop": "deploymentId" },
        { "prop": "alternateDeploymentName" },
        { "prop": "instrument" },
        { "prop": "instrumentId" }
      ]
    },
    {
      "id": "calibration",
      "label": "Calibration and Resources",
      "description": "Instrument calibration and related data locations",
      "fields": [
        {
          "id": "sensitivity_calibration_state_wrapper",
          "type": "objectWrapper",
          "label": "",
          "layout": "grid2",
          "fields": [{ "prop": "sensitivityFlatValue" }, { "prop": "calibrationState" }]
        },
        {
          "id": "calibration_dates_wrapper",
          "type": "objectWrapper",
          "label": "",
          "layout": "grid2",
          "fields": [{ "prop": "preDeploymentCalibrationDate" }, { "prop": "postDeploymentCalibrationDate" }]
        },
        { "prop": "calibrationDescription", "type": "long_text" },
        { "prop": "sourceURI" },
        { "prop": "calibrationDocumentsURI" },
        { "prop": "documentsURI" },
        { "prop": "temperatureURI" },
        { "prop": "otherURI" }
      ]
    },
    {
      "id": "timing",
      "label": "Deployment Timing",
      "fields": [
        {
          "id": "deployment_recovery_times_wrapper",
          "type": "objectWrapper",
          "label": "",
          "layout": "grid2",
          "fields": [{ "prop": "deploymentTime" }, { "prop": "recoveryTime" }]
        },
        {
          "id": "audio_times_wrapper",
          "type": "objectWrapper",
          "label": "",
          "layout": "grid2",
          "fields": [{ "prop": "audioStartTime" }, { "prop": "audioEndTime" }]
        },
        { "prop": "comments", "type": "long_text" }
      ]
    },
    {
      "id": "recordings",
      "label": "Recordings",
      "description": "Audio channels, sample rates, and duty cycles",
      "fields": [
        {
          "prop": "recordings",
          "type": "object",
          "multiple": true,
          "fields": [
            {
              "prop": "recordings[].channels",
              "type": "object",
              "multiple": true,
              "fields": [
                {
                  "id": "recording_channel_times_wrapper",
                  "type": "objectWrapper",
                  "label": "",
                  "layout": "grid2",
                  "settings": { "className": "p-0 bg-transparent" },
                  "fields": [{ "prop": "recordings[].channels[].startTime" }, { "prop": "recordings[].channels[].endTime" }]
                },
                {
                  "prop": "recordings[].channels[].sampleRates",
                  "type": "object",
                  "multiple": true,
                  "layout": "grid2",
                  "fields": [
                    { "prop": "recordings[].channels[].sampleRates[].startTime" },
                    { "prop": "recordings[].channels[].sampleRates[].endTime" },
                    { "prop": "recordings[].channels[].sampleRates[].sampleRate" },
                    { "prop": "recordings[].channels[].sampleRates[].sampleBits" }
                  ]
                },
                {
                  "prop": "recordings[].channels[].dutyCycles",
                  "type": "object",
                  "multiple": true,
                  "layout": "grid2",
                  "fields": [
                    { "prop": "recordings[].channels[].dutyCycles[].startTime" },
                    { "prop": "recordings[].channels[].dutyCycles[].endTime" },
                    { "prop": "recordings[].channels[].dutyCycles[].duration" },
                    { "prop": "recordings[].channels[].dutyCycles[].interval" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "analyses",
      "label": "Analyses",
      "description": "Quality assessments and quality intervals",
      "fields": [
        {
          "prop": "analyses",
          "type": "object",
          "multiple": true,
          "fields": [
            { "prop": "analyses[].qualityAnalyst" },
            { "prop": "analyses[].qualityAssessmentDescription", "type": "long_text" },
            {
              "prop": "analyses[].qualityEntries",
              "type": "object",
              "multiple": true,
              "fields": [
                {
                  "id": "quality_entry_times_wrapper",
                  "type": "objectWrapper",
                  "label": "",
                  "layout": "grid2",
                  "fields": [{ "prop": "analyses[].qualityEntries[].startTime" }, { "prop": "analyses[].qualityEntries[].endTime" }]
                },
                {
                  "id": "quality_frequency_level_wrapper",
                  "type": "objectWrapper",
                  "label": "",
                  "layout": "grid3",
                  "fields": [
                    { "prop": "analyses[].qualityEntries[].minFrequency", "settings": { "descriptionPresentation": "tooltip" } },
                    { "prop": "analyses[].qualityEntries[].maxFrequency", "settings": { "descriptionPresentation": "tooltip" } },
                    { "prop": "analyses[].qualityEntries[].qualityLevel" }
                  ]
                },
                { "prop": "analyses[].qualityEntries[].comments", "type": "long_text" },
                { "prop": "analyses[].qualityEntries[].channelNumbers" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
'::jsonb;
END;
$function$ LANGUAGE plpgsql;

